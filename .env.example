# Who the agent speaks for.
OWNER_NAME=Alex
# he, she or they: "I'm his/her/their assistant".
OWNER_PRONOUNS=they
# Optional: what the call screener may say about you, and use in small talk.
# e.g. OWNER_BIO=Alex restores old motorbikes, so ask callers how their product would help with that.
OWNER_BIO=
TIMEZONE=Australia/Sydney
CALL_HOURS=08:30-18:30

# Asterisk (FreePBX 17). ARI user: Settings > Asterisk REST Interface Users.
ARI_URL=http://freepbx.lan:8088/ari
ARI_USER=phoneagent
ARI_PASSWORD=change-me
# Goes through FreePBX outbound routes (and the Internode trunk).
DIAL_ENDPOINT=Local/{number}@from-internal/n
CALLER_ID=
RING_TIMEOUT_SECONDS=45
# Optional: AMI over HTTP for real keypad presses (many phone menus ignore tones).
# Needs a manager user allowed from this host, read/write = call, and webenabled = yes.
AMI_URL=http://freepbx.lan:8088/rawman
AMI_USER=phoneagent
AMI_PASSWORD=

# How Asterisk reaches this container's AudioSocket port.
AUDIOSOCKET_ADVERTISE=agent.lan:9092
# Must match c(slinNN) in asterisk/extensions_custom.conf: 16000 = slin16.
AUDIO_RATE=16000

# Wyoming containers (the ones Home Assistant uses).
WYOMING_STT=agent.lan:10300
# The bundled agent Piper (docker-compose service "piper"), or your own: host:port
WYOMING_TTS=piper:10200
PIPER_VOICE=en_GB-jenny_dioco-medium
# Speaking speed: 1.0 = normal, higher = slower (1.12 ≈ 95% of normal pace)
PIPER_LENGTH_SCALE=1.12
STT_LANGUAGE=en
TTS_VOICE=
# How the voice should say awkward names (comma-separated word=spelling).
# e.g. TTS_PRONOUNCE=Siobhan=Shivawn,Nguyen=Win
TTS_PRONOUNCE=

# In-call brain: claude:<model> (needs ANTHROPIC_API_KEY) or ollama:<model>.
DIALOG_LLM=claude:claude-haiku-5-5
ANTHROPIC_API_KEY=
OLLAMA_URL=http://agent.lan:11434
# Match what Home Assistant uses, so calls never shorten how long the model stays loaded.
OLLAMA_KEEP_ALIVE=-1

MAX_CONCURRENT_CALLS=1
# Incoming calls handed over by the dialplan (context phone-agent-inbound).
MAX_INBOUND_CALLS=1
INBOUND_MAX_SECONDS=900
MAX_CALL_SECONDS=480
HOLD_TIMEOUT_SECONDS=240
BARGE_IN=true

# Required: MCP clients send "Authorization: Bearer <token>", browsers sign in once.
# Make one with: openssl rand -hex 32 (or keep it in secrets.env). The agent won't start
# without it unless ALLOW_NO_AUTH=true.
API_TOKEN=

# Links in tool results point here.
PUBLIC_URL=http://agent.lan:8090
# Set if FreePBX's /var/spool/asterisk/monitor is mounted into the container.
RECORDINGS_DIR=
